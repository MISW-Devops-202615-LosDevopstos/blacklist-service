# Copiar este archivo como .env y completar los valores. El .env NO se sube al repo.

# Base de datos local (docker-compose). En Beanstalk va el endpoint de RDS.
DATABASE_URL=postgresql://blacklist:blacklist@localhost:5432/blacklist

# Llave para firmar y validar el token. Generarla con:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Versión que muestra /ping. Cambiarla en cada despliegue.
APP_VERSION=1.0.0
