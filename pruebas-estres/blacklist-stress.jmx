<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3"><hashTree><TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Blacklist service - prueba de estrés"><stringProp name="TestPlan.comments">Prueba de estrés del blacklist-service (Entrega 4). Parámetros (-Jnombre=valor): token (obligatorio), host (localhost), puerto (8000), protocolo (http), minuto (60 = segundos por minuto del plan; 6 = ensayo de 3 min), base_usuarios (5), carga_usuarios (25), estres_usuarios (50), estres_extra_usuarios (50), rafaga_usuarios (20), recuperacion_usuarios (5).</stringProp><boolProp name="TestPlan.functional_mode">false</boolProp><boolProp name="TestPlan.serialize_threadgroups">false</boolProp><boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp><elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments"><collectionProp name="Arguments.arguments"/></elementProp></TestPlan><hashTree><ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="Servidor (host, puerto y protocolo por parámetro)"><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments"><collectionProp name="Arguments.arguments"/></elementProp><stringProp name="HTTPSampler.domain">${__P(host,localhost)}</stringProp><stringProp name="HTTPSampler.port">${__P(puerto,8000)}</stringProp><stringProp name="HTTPSampler.protocol">${__P(protocolo,http)}</stringProp><stringProp name="HTTPSampler.connect_timeout">5000</stringProp><stringProp name="HTTPSampler.response_timeout">30000</stringProp><stringProp name="HTTPSampler.implementation">HttpClient4</stringProp></ConfigTestElement><hashTree></hashTree><HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Content-Type JSON"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">Content-Type</stringProp><stringProp name="Header.v